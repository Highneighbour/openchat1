{
  "name": "eliza-openchat-bot",
  "version": "1.0.0",
  "description": "An intelligent AI agent powered by ElizaOS integrated with OpenChat",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx server.ts",
    "watch": "nodemon --exec tsx server.ts",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": [
    "eliza",
    "elizaos",
    "openchat",
    "ai",
    "bot",
    "internet-computer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai16z/adapter-sqlite": "^0.1.6",
    "@ai16z/eliza": "^0.1.6",
    "@open-ic/openchat-botclient-ts": "^1.0.61",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
