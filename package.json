{
  "name": "@elizaos/plugin-openchat",
  "description": "ElizaOS plugin for OpenChat integration - enables agents to interact with OpenChat platform",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageType": "plugin",
  "platform": "node",
  "license": "MIT",
  "author": "ElizaOS Team",
  "keywords": [
    "plugin",
    "elizaos",
    "openchat",
    "bot",
    "communication",
    "internet-computer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/elizaos/eliza"
  },
  "homepage": "https://elizaos.ai",
  "bugs": {
    "url": "https://github.com/elizaos/eliza/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    ".npmignore",
    ".gitignore",
    "package.json"
  ],
  "dependencies": {
    "@open-ic/openchat-botclient-ts": "^1.0.61",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "dotenv": "^16.4.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "start": "elizaos start",
    "dev": "elizaos dev",
    "build": "tsc",
    "lint": "prettier --write ./src",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "OC_PUBLIC": {
        "type": "string",
        "description": "OpenChat public key for JWT verification"
      },
      "IC_HOST": {
        "type": "string",
        "description": "Internet Computer host URL"
      },
      "IDENTITY_PRIVATE": {
        "type": "string",
        "description": "Private key for bot identity"
      },
      "STORAGE_INDEX_CANISTER": {
        "type": "string",
        "description": "OpenStorage index canister ID"
      },
      "BOT_SERVER_URL": {
        "type": "string",
        "description": "URL where the bot server is hosted"
      }
    }
  }
}