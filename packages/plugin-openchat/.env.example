# OpenChat Bot Configuration

# Required: OpenChat public key for JWT verification
# Get this from OpenChat profile -> Advanced -> Bot client data
OPENCHAT_PUBLIC_KEY=

# Required: Internet Computer host URL
# Use https://ic0.app for mainnet or http://localhost:8000 for local development
OPENCHAT_IC_HOST=https://ic0.app

# Required: Bot identity private key in PEM format
# Generate with: openssl ecparam -genkey -name secp256k1 -out private_key.pem
OPENCHAT_IDENTITY_PRIVATE_KEY=

# Required: OpenStorage canister ID
# Get this from OpenChat profile -> Advanced -> Bot client data
OPENCHAT_STORAGE_INDEX_CANISTER=

# Optional: Port for OpenChat bot server (default: 3000)
OPENCHAT_BOT_PORT=3000
