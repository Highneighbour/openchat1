# OpenChat Bot Configuration
# Required for OpenChat integration
OC_PUBLIC=your_openchat_public_key_here
IC_HOST=https://icp-api.io
IDENTITY_PRIVATE=your_identity_private_key_here
STORAGE_INDEX_CANISTER=your_storage_index_canister_id_here

# Server Configuration
PORT=3000

# ElizaOS Configuration
# OpenAI API Key (required for ElizaOS)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
MODEL_PROVIDER=openai
AI_MODEL=gpt-4

# Database Configuration
ELIZA_DB_PATH=./data/eliza.db

# Optional: Use other model providers
# For Anthropic (Claude):
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-3-opus-20240229

# For Google (Gemini):
# MODEL_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# AI_MODEL=gemini-pro

# For Grok:
# MODEL_PROVIDER=grok
# GROK_API_KEY=your_grok_api_key_here

# Logging
LOG_LEVEL=info
