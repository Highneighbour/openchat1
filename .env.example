# OpenChat Bot Configuration
# Get these from registering your bot on OpenChat (https://oc.app)
OPENCHAT_PUBLIC_KEY=your_openchat_public_key_here
OPENCHAT_IDENTITY_PRIVATE=your_identity_private_key_here
OPENCHAT_STORAGE_CANISTER=your_storage_index_canister_id_here
OPENCHAT_IC_HOST=https://icp-api.io
OPENCHAT_PORT=3000

# AI Model Configuration
# Required: At least one AI provider API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Other supported AI providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here
# GROK_API_KEY=your_grok_api_key_here

# Model Settings
MODEL_PROVIDER=openai
AI_MODEL=gpt-4

# Database (ElizaOS will handle this)
# Default: Uses SQLite in the agent's data directory
