# OpenChat Plugin Configuration
# Copy this file to .env and fill in your values

# Required: OpenChat public key for JWT verification
# Get this from OpenChat user profile > Advanced > Bot client data
OPENCHAT_PUBLIC_KEY=

# Required: Internet Computer host URL
# Use https://ic0.app for mainnet or your local IC URL for development
IC_HOST=https://ic0.app

# Required: Bot identity private key (PEM format)
# Generate with: openssl ecparam -genkey -name secp256k1 -out private_key.pem
# Then paste the full contents here (including -----BEGIN EC PRIVATE KEY-----)
IDENTITY_PRIVATE_KEY=

# Required: OpenStorage canister ID
# Get this from OpenChat user profile > Advanced > Bot client data
STORAGE_INDEX_CANISTER=

# Optional: Port for the OpenChat bot server (default: 3000)
OPENCHAT_BOT_PORT=3000

# Optional: Enable autonomous mode (default: false)
# When true, bot can proactively send messages based on events
OPENCHAT_AUTONOMOUS=false
