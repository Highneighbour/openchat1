# OpenChat Bot Configuration
# Copy this file to .env and fill in your values

# Your OpenChat public key for JWT verification
OPENCHAT_PUBLIC_KEY=your_openchat_public_key_here

# Internet Computer host (usually this default value)
OPENCHAT_IC_HOST=https://icp0.io

# Your bot's private identity key (keep this secret!)
OPENCHAT_IDENTITY_PRIVATE_KEY=your_private_key_here

# OpenStorage canister ID from OpenChat
OPENCHAT_STORAGE_CANISTER_ID=your_canister_id_here

# Port for the bot server (default: 3000)
OPENCHAT_BOT_PORT=3000
