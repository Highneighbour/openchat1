# OpenChat Bot Configuration for Testing
# Copy this to .env and fill in your actual values

# OpenChat Configuration (REQUIRED - Get from OpenChat bot registration)
OPENCHAT_PUBLIC_KEY=your_openchat_public_key_here
OPENCHAT_IC_HOST=https://icp0.io
OPENCHAT_IDENTITY_PRIVATE_KEY=your_bot_private_key_here
OPENCHAT_STORAGE_CANISTER_ID=your_storage_canister_id_here

# Bot Server Configuration
OPENCHAT_BOT_PORT=3001

# Bot Information (Optional - for standalone mode)
BOT_NAME=ElizaBot
BOT_BIO=An AI assistant powered by Eliza OS on OpenChat
